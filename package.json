{
  "name": "medway-stamps",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "npm run cf-typegen && react-router typegen && tsc -b",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply medway-stamps-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply medway-stamps-db --remote",
    "db:seed:local": "wrangler d1 execute medway-stamps-db --local --file=./db/seed.sql",
    "db:seed:remote": "wrangler d1 execute medway-stamps-db --remote --file=./db/seed.sql",
    "db:seed:admin:local": "node scripts/seed-admin.mjs --local",
    "db:seed:admin:remote": "node scripts/seed-admin.mjs --remote",
    "db:pull:remote": "node scripts/pull-remote-data.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "isbot": "^5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "stripe": "^17.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@react-router/cloudflare": "^7.18.4",
    "@react-router/dev": "^7.18.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.28.1",
    "sass": "^1.103.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "wrangler": "^4.135.0"
  }
}

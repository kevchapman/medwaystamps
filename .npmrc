# wrangler@4.135's optional peer on @cloudflare/workers-types@^5.x conflicts
# with @react-router/cloudflare@7.18.4's required peer on ^4.x — a types-only
# mismatch (no runtime effect either way), not a real incompatibility. Needed
# so both local `npm install` and CI's `npm ci` resolve consistently.
legacy-peer-deps=true
